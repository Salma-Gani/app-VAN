# ─────────────────────────────────────────────────────────────
# EcoInvest Pro — configuration (optionnelle)
# Copiez ce fichier en « .env » puis renseignez UNE des clés ci-dessous.
# L'application détecte automatiquement le fournisseur disponible.
# Sans aucune clé, l'agent IA bascule en mode « analyste local » (hors-ligne).
# ─────────────────────────────────────────────────────────────

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral (https://console.mistral.ai/)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Ollama local (aucune clé, exécuter « ollama serve »)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Fournisseur forcé : openai | anthropic | deepseek | groq | gemini | mistral | ollama | local
ECOINVEST_LLM_PROVIDER=

# Taux sans risque annuel pour le marché marocain (BAM ~2,75 %)
ECOINVEST_RISK_FREE_RATE=0.0275
